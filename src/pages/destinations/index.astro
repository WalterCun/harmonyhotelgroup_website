---
import { lang_es } from "lib/constants";
import Layout from "globals/layout/Layout.astro";
import { getCollection } from "astro:content";

const { lang = lang_es } = Astro.props;

// Obtener destinos reales
const destinations = (await getCollection("destinations"))
  .map((item) => {
    const data = item.data;
    return {
      id: item.id,
      name: data.name,
      location: data.location,
      description: data.description_destination?.find((d) => d.lang_destination === lang)?.content_destination || data.description_destination?.[0]?.content_destination || '',
      coverImage: data.coverImage,
      tags: data.tags || [],
    };
  });
---

<Layout lang={lang} title="Destinos">
  <div class="bg-primary-500/10 dark:bg-neutral-800 py-12">
    <div class="container">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl drop-shadow-md text-primary text-center mb-2">
        Explora Nuestros Destinos
      </h1>
      <p class="text-center text-lg text-neutral-700 max-w-3xl mx-auto mb-8">
        Encuentra tu escapada perfecta en nuestra lista de destinos de clase mundial.
      </p>
      <!-- Filtro visual -->
      <div class="bg-white border border-gray-200 shadow rounded-lg p-4 mb-8 flex flex-col md:flex-row items-center gap-4">
        <label class="font-semibold text-primary text-lg mr-4">Filtrar Destinos</label>
        <input type="text" placeholder="Buscar destinos (ej: París, Playa, Italia...)" class="input input-bordered w-full max-w-xl" />
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {destinations.map(destination => (
          <div class="bg-white rounded-xl shadow hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden">
            <div class="relative h-60 bg-gray-200 flex items-center justify-center">
              {destination.coverImage ? (
                <img src={destination.coverImage} alt={destination.name} class="w-full h-full object-cover" />
              ) : (
                <span class="text-3xl text-gray-400">600 × 400</span>
              )}
            </div>
            <div class="p-5 flex flex-col flex-1">
              <div class="mb-2">
                <span class="inline-block bg-gray-100 text-gray-700 text-xs font-semibold rounded px-2 py-1 mb-1">
                  {destination.location}
                </span>
              </div>
              <h3 class="text-xl font-bold mb-1 text-primary">{destination.name}</h3>
              <p class="text-neutral-600 mb-3 line-clamp-3 flex-1">
                {destination.description}
              </p>
              <button class="mt-auto w-full bg-primary text-white font-semibold py-2 rounded transition hover:bg-primary-600">
                Explorar Destino
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>