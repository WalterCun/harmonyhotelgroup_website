---
import { lang_es } from "lib/constants";
import { trans } from "utils/translations";
// import Layout from "core/layouts/Layout.astro";
import Layout from "globals/layout/Layout.astro";

interface Props {
  lang: string;
}

const { lang = lang_es } = Astro.props;

---

<Layout lang={lang} title={trans(lang, "404.title-page")}>
  <section class="page_404 flex flex-col items-center justify-center min-h-screen bg-white">
    <div class="container mx-auto flex flex-col items-center justify-center mt-20">
      <div class="w-full max-w-4xl text-center">
          <h1 class="text-9xl font-serif font-bold text-primary-500 mb-2">{trans(lang, "404.title")}</h1>
        <div class="four_zero_four_bg flex items-center justify-center mb-8">
          <img src="https://cdn.dribbble.com/users/285475/screenshots/2083086/dribbble_1.gif" alt="Búsqueda no encontrada" class="mx-auto w-96 h-96 md:w-[500px] md:h-[500px] object-contain" />
        </div>
        <p class="text-gray-800  max-w-md mx-auto mb-10">{trans(lang, "404.description")}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="px-6 py-3 bg-primary-500 text-white rounded-md hover:bg-primary-600 transition-colors font-semibold shadow">
            {trans(lang, "404.btn-home")}
          </a>
          <a href="/contact" class="px-6 py-3 bg-secondary-500 text-white rounded-md hover:bg-secondary-600 transition-colors font-semibold shadow">
            {trans(lang, '404.btn-contact')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.page_404 {
  padding: 40px 0;
  font-family: 'Arvo', serif;
}
.four_zero_four_bg img {
  width: 100%;
  max-width: 750px;
  height: auto;
  display: block;
  margin: 0 auto;
}
.text-primary-500 {
  color: #3b82f6;
}
.bg-primary-500 {
  background-color: #3b82f6;
}
.bg-primary-600 {
  background-color: #2563eb;
}
.bg-secondary-500 {
  background-color: #f59e42;
}
.bg-secondary-600 {
  background-color: #d97706;
}
</style>