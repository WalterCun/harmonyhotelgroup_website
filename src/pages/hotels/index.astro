                                  name,
                                  amenities,
                                  stars,
                                  location,
                              } = hotel.data;
                              return (
                                      <HotelCard
                                              id={hotel.id}
                                              coverImage={coverImage}
                                              location={location}
                                              name={name}
                                              stars={stars}
                                              amenities={amenities}
                                              roomPrice={roomPrice}
                                              partner={partner}
                                              lang={lang}
                                      />
                              );
                          })
                      }
