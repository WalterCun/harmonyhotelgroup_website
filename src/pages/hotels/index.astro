---
import { lang_es } from "lib/constants";
import Layout from "globals/layout/Layout.astro";
import { getCollection } from "astro:content";
import { createLogger, trans } from "../../utils";
import { type CityOption } from "../../lib/constants";
import HotelCard from "../../components/core/cards/HotelCard.astro";

const logger = createLogger(false, "hotels.astro");

let hotels: any[] = [];
let uniqueCities: CityOption[] = [];
let uniqueAmenities: string[] = [];

try {
  hotels = (await getCollection("hotels"))
    .sort((a, b) => a.data.name.localeCompare(b.data.name))
    .sort((a, b) => (b.data.partner === true ? -1 : 1));

  // Cast explícito para mantener el tipo CityOption
  uniqueCities = [
    ...new Set(hotels.map((hotel) => hotel.data.location)),
  ] as CityOption[];

  // Extract amenities from all hotels - con manejo seguro
  const allAmenities = hotels.flatMap((hotel) => {
    // Verificar que el hotel tiene la estructura esperada
    if (!hotel.data.amenities?.[0]) {
      return [];
    }

    const amenitiesObj = hotel.data.amenities[0];
    return [
      ...(amenitiesObj.basic_services || []),
      ...(amenitiesObj.general_services || []),
      ...(amenitiesObj.extra_services || []),
      ...(amenitiesObj.premium_services || []),
    ];
  });
  uniqueAmenities = [...new Set(allAmenities)];

  logger.log("All hotels loaded successfully:", hotels.length);
} catch (error) {
  logger.error("Error loading hotels:", error);
}

const { lang = lang_es } = Astro.props;
---
<Layout lang={lang} title={trans(lang,"hotels.index.page_title")} className="pt-35">
    <div class="flex justify-center w-full bg-white py-10">
        <div class="container">
            <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl drop-shadow-md text-primary text-center mb-6">
                {trans(lang,"hotels.index.title")}
            </h1>
            <p class="text-center text-lg text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto">
                {trans(lang,"hotels.index.subtitle")}
            </p>
                <div class="bg-white dark:bg-neutral-800 shadow-md rounded-lg p-6 mb-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        <div>
                            <label for="destination"
                                   class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Destination</label>
                            <select id="destination" class="select">
                                <option value="">All</option>
                                {
                                    uniqueCities.map(item => {
                                        return (<option value={item}>{item}</option>)
                                    })
                                }
                            </select>
                        </div>

                        <div>
                            <label for="price"
                                   class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Price
                                Range</label>
                            <select id="price" class="select">
                                <option value="">Any Price</option>
                                <option value="budget">Under $200</option>
                                <option value="mid">$200 - $350</option>
                                <option value="luxury">$350 - $500</option>
                                <option value="ultra">$500+</option>
                            </select>
                        </div>

                        <div>
                            <label for="amenities"
                                   class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-1">Amenities</label>
                            <select id="amenities" class="select">
                                <option value="">All</option>
                                {
                                    uniqueAmenities.map(item => {
                                        return (<option value={item}>{item}</option>)
                                    })
                                }
                            </select>
                        </div>

                        <div class="flex items-end">
                            <button class="btn btn-primary w-full">
                                Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
                {hotels.length > 0 ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                      {
                          hotels.map((hotel) => {
                              const {
                                  coverImage,
                                  roomPrice,
