---
import { Icon } from "astro-icon/components";

import { infoAddress, socialLinks } from "~/lib/constants";
---

<div class="flex justify-between items-center py-5">
    <div class="flex items-center gap-4">
        {
            socialLinks.map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cursor-pointer text-primary hover:text-white transition-colors duration-200"
                >
                    <link.icon />
                </a>
            ))
        }
    </div>
    <div class="flex items-center gap-4">
        <a
            href={infoAddress.addressLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start group"
        >
            <i class="text-primary shrink-0 mr-2">
                <Icon name="location" width={25} height={25} />
            </i>
            <span class="text-neutral-700 dark:text-neutral-300 group-hover:text-white transition-colors duration-200">
                {infoAddress.address}
            </span>
        </a>

        <a href={`tel:${infoAddress.phone}`} class="flex items-start group">
            <i class="text-primary shrink-0">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-5 h-5 mr-2 text-primary-500 shrink-0"
                >
                    <path
                        fill-rule="evenodd"
                        d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
                        clip-rule="evenodd"></path>
                </svg>
            </i>
            <span class="text-neutral-700 dark:text-neutral-300 group-hover:text-white transition-colors duration-200">
                {infoAddress.phone}
            </span>
        </a>
    </div>
</div>
