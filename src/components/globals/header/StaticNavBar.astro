---
import LanguageSwitcher from "core/ui/DropDownLanguage.astro";
import Navigation from "./Navigation.astro";
import HeaderStaticNav from "globals/header/HeaderStaticNav.astro";
import ContainerStaticNav from "../../core/layouts/ContainerStaticNav.astro";
import LogoHGG from "../svg/logos/LogoHGG.astro";
import MenuIcon from "../../core/ui/MenuIcon.astro";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
---

<nav class="w-full bg-trarensparent absolute top-0 left-0 z-10">
    <ContainerStaticNav>
        <HeaderStaticNav />
    </ContainerStaticNav>
    <!-- Divider -->
    <div class="w-full h-px bg-gray-500/30"></div>
    <ContainerStaticNav>
        <div class="flex justify-between items-center">
            <a href="/" class="block size-20">
                <LogoHGG />
            </a>

            <div class="flex items-center gap-4">
                <Navigation lang={lang} />

                <div class="shrink-0 flex items-center space-x-1 md:space-x-2">
                    <LanguageSwitcher lang={lang} />
                    <MenuIcon />
                </div>
            </div>
        </div>
    </ContainerStaticNav>
</nav>
