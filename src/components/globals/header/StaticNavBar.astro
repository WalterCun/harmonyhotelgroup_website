---
import LanguageSwitcher from "core/ui/DropDownLanguage.astro";
import Navigation from "./Navigation.astro";
import HeaderStaticNav from "globals/header/HeaderStaticNav.astro";
import Container from "../../core/layouts/Container.astro";
import Logo from "../../core/Logo.astro";
import DrawerMenuNav from "../../core/ui/DrawerMenuNav.astro";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
---

<nav class="w-full bg-trarensparent absolute top-0 left-0 z-10">
    <Container>
        <HeaderStaticNav />
    </Container>
    <Container>
        <div class="flex justify-between items-center">
            <a href="/" class="block">
                <Logo />
            </a>

            <div class="flex items-center gap-4">
                <Navigation lang={lang} />

                <div class="shrink-0 flex items-center gap-2">
                    <LanguageSwitcher lang={lang} />
                    <DrawerMenuNav />
                </div>
            </div>
        </div>
    </Container>
</nav>
