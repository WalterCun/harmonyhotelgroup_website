---
import LanguageSwitcher from "core/ui/DropDownLanguage.astro";
import HeaderStaticNav from "globals/header/HeaderStaticNav.astro";
import Logo from "../../core/Logo.astro";
import Container from "../../core/layouts/Container.astro";
import DrawerMenuNav from "../../core/ui/DrawerMenuNav.astro";
import Navigation from "./Navigation.astro";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<nav class="w-full bg-trarensparent absolute top-0 left-0 z-10 sm:hidden md:block">
  <Container>
    <HeaderStaticNav />
    <div class="flex justify-between items-center">
      <Logo />
      <div class="flex items-center gap-4">
        <Navigation lang={lang} />

        <div class="shrink-0 flex items-center gap-2">
          <LanguageSwitcher lang={lang} />
          <DrawerMenuNav />
        </div>
      </div>
    </div>
  </Container>
</nav>
