---
import { socialLinks } from "~/lib/constants/social";

const address = {
    location: "Global Headquarters",
    address: "123 Harmony Plaza, New York, NY 10001, USA",
    addressLink: "https://www.google.com/maps/place/123+Harmony+Plaza,+New+York,+NY+10001,+USA/@40.7127755,-74.0059728,15z/data=!4m5!3m4!1s0x89c2585ff9df2f6d:0xf876c67b1d0153d4!8m2!3d40.7127755!4d-74.0059728",
    phone: "+1 (212) 555-1234",
    email: "info@harmonyhotelgroup.com",
    hours: "Monday - Friday: 9:00 AM - 6:00 PM EST",
};
---

<div class="flex justify-between items-center py-5">
    <div class="flex items-center gap-4">
        {
            socialLinks.map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cursor-pointer hover:text-primary transition-colors duration-200"
                >
                    <link.icon />
                </a>
            ))
        }
    </div>
    <div class="flex items-center gap-4">
        <div class="">
            <a href={address.addressLink} target="_blank" rel="noopener noreferrer" class="flex items-start">
                <i class="text-primary shrink-0">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-5 h-5 mr-3 text-primary-500 shrink-0"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z"
                            clip-rule="evenodd"></path>
                    </svg>
                </i>
                <span class="text-neutral-700 dark:text-neutral-300">
                    {address.address}
                </span>
            </a>
        </div>

        <div class="">
            <a href={`tel:${address.phone}`} class="flex items-start">
                <i class="text-primary shrink-0">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="w-5 h-5 mr-3 text-primary-500 shrink-0"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
                            clip-rule="evenodd"></path>
                    </svg>
                </i>
                <span class="text-neutral-700 dark:text-neutral-300">
                    {address.phone}
                </span>
            </a>
        </div>
    </div>
</div>
