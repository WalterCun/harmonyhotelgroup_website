---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Footer from "~/components/globals/Footer.astro";
import SizeIndicator from "~/components/globals/SizeIndicator.astro";
import StaticNavBar from "~/components/globals/StaticNavBar.astro";
import "~/styles/global.css";
import { trans } from "~/utils/translations";

interface Props {
    lang: string;
    title?: string;
}

const { lang, title = "" } = Astro.props;

const staticTitle = `${trans(lang, "layouts.layout.meta.title")}`;
const dynamicTitle =
    title !== "" ? `${staticTitle} | ${title}` : `${staticTitle}`;
---

<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, maximum-scale=5, minimum-scale=1"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content={trans(lang, "layouts.layout.meta.description")}
        />
        <title>{dynamicTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="min-h-screen flex flex-col bg-neutral-50 text-neutral-800 dark:bg-neutral-900 dark:text-neutral-100 transition-colors duration-300"
    >
        <StaticNavBar lang={lang} />
        <main class="grow">
            <slot />
        </main>
        <Footer lang={lang} />
        <SizeIndicator />
        <!-- <SpeedInsights /> -->
    </body>
</html>
