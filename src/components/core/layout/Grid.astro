---
interface Props {
  class?: string;
  cols?: 1 | 2 | 3 | 4 | 5 | 6;
  gap?: 'none' | 'sm' | 'md' | 'lg';
  items?: 'start' | 'center' | 'end' | 'stretch';
  justify?: 'start' | 'center' | 'end' | 'between' | 'around';
}

const {
  class: className = "",
  cols = 1,
  gap = 'md',
  items = 'stretch',
  justify = 'start'
} = Astro.props;

const colsClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
  5: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-5',
  6: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-6'
};

const gapClasses = {
  'none': '',
  'sm': 'gap-2 sm:gap-4',
  'md': 'gap-4 sm:gap-6',
  'lg': 'gap-6 sm:gap-8'
};

const itemsClasses = {
  'start': 'items-start',
  'center': 'items-center',
  'end': 'items-end',
  'stretch': 'items-stretch'
};

const justifyClasses = {
  'start': 'justify-start',
  'center': 'justify-center',
  'end': 'justify-end',
  'between': 'justify-between',
  'around': 'justify-around'
};
---

<div class:list={[
  'grid',
  colsClasses[cols],
  gapClasses[gap],
  itemsClasses[items],
  justifyClasses[justify],
  className
]}>
  <slot />
</div> 