---
import LogoHGG from "../globals/svg/logos/LogoHGG.astro";

interface Props {
	class?: string;
	showText?: boolean;
	showImage?: boolean;
	showIsologo?: boolean;
}

const {
	class: className = "",
	showText = true,
	showImage = true,
	showIsologo = true,
} = Astro.props;
---

<a href="/" class={`logo-container ${className}`}>
  <!-- Imagen + texto - visible en pantallas medianas y grandes -->
  <div class="hidden md:flex items-center gap-2">
    {showImage && (
      <div class="logo-image">
        <LogoHGG />
      </div>
    )}
    {showText && (
      <div class="logo-text">
        <span class="text-xl font-bold text-primary">Harmony</span>
        <span class="text-lg font-medium text-secondary">Hotel Group</span>
      </div>
    )}
  </div>

  <!-- Solo imagen - visible en pantallas pequeñas -->
  <div class="flex md:hidden items-center">
    {showImage && (
      <div class="logo-image-small">
        <LogoHGG />
      </div>
    )}
  </div>
</a>

<style>
  .logo-container {
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  .logo-image {
    width: 60px;
    height: 60px;
  }

  .logo-image-small {
    width: 40px;
    height: 40px;
  }

  .logo-isologo {
    width: 50px;
    height: 50px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    gap: 0.1rem;
  }

  .logo-text-small {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    gap: 0.05rem;
  }

  /* Asegurar que el SVG se ajuste al contenedor */
  .logo-image :global(svg),
  .logo-image-small :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Hover effects */
  .logo-container:hover .logo-text span:first-child {
    color: hsl(var(--accent));
  }

  .logo-container:hover .logo-text span:last-child {
    color: hsl(var(--accent) / 0.8);
  }

  /* Hover effect para las imágenes */
  .logo-container:hover .logo-image,
  .logo-container:hover .logo-image-small {
    transform: scale(1.05);
  }
</style>