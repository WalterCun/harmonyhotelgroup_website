---
import { cn } from "~/utils";

interface Props {
	lang?: string;
	className?: string;
	backgroundColor?: "white" | "neutral" | "gray";
}

const { lang, className, backgroundColor = "white", ...rest } = Astro.props;

const baseClasses =
	"card bg-base-100 w-auto shadow-sm hover:shadow-xl transition-all duration-300";

const bgColorClasses = {
	white: "bg-white",
	neutral: "bg-neutral-50",
	gray: "bg-gray-50",
};

const classes = cn(baseClasses, bgColorClasses[backgroundColor], className);
---

<div class={classes} {...rest}>
    <slot/>
</div>
