---
interface Props {
  class?: string;
  fluid?: boolean;
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full';
  padding?: boolean;
}

const {
  class: className = "",
  fluid = false,
  maxWidth = 'xl',
  padding = true
} = Astro.props;

const maxWidthClasses = {
  'sm': 'max-w-screen-sm',
  'md': 'max-w-screen-md',
  'lg': 'max-w-screen-lg',
  'xl': 'max-w-screen-xl',
  '2xl': 'max-w-screen-2xl',
  'full': 'max-w-full'
};

const containerClass = fluid 
  ? 'w-full' 
  : `${maxWidthClasses[maxWidth]} mx-auto`;

const paddingClass = padding ? 'px-4 sm:px-6 lg:px-8' : '';
---

<div class:list={[containerClass, paddingClass, className]}>
  <slot />
</div>

<style>
  div {
    width: 100%;
  }
</style>