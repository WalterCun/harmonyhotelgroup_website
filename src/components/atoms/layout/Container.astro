---
import { cn } from "~/utils";

interface Props {
  className?: string;
  fluid?: boolean;
  maxWidth?: "sm" | "md" | "lg" | "xl" | "2xl" | "4xl" | "full";
  padding?: boolean;
  paddingY?: boolean; // Nuevo
}

const {
  className = "",
  fluid = false,
  maxWidth = "full",
  padding = true,
  paddingY = true,
} = Astro.props;

const maxWidthClasses = {
  sm: "max-w-screen-sm",
  md: "max-w-screen-md",
  lg: "max-w-screen-lg",
  xl: "max-w-screen-xl",
  "2xl": "max-w-screen-2xl",
  "4xl": "max-w-screen-4xl",
  full: "max-w-full",
};

const containerClass = fluid
  ? `w-full ${maxWidthClasses[maxWidth]}`
  : `${maxWidthClasses[maxWidth]} mx-auto`;

const paddingX = padding ? "px-4 sm:px-6 lg:px-8" : "";
const paddingYClass = paddingY ? "py-4 sm:py-6 lg:py-8" : "";
---

<div class={cn(containerClass, paddingX, paddingYClass, className)}>
  <slot />
</div>
