---
import { cn } from "../../../utils";
interface Props {
  className?: string;
  padding?: "default";
  background?: "default" | "gray";
  fullWidth?: boolean;
}

const {
  className = "",
  padding = "default",
  background = "default",
} = Astro.props;

const paddingClass = {
  default: "",
};

const bgClass = {
  default: "bg-white",
  gray: "bg-gray-200",
};
---

<section class={cn(
    paddingClass[padding],
    bgClass[background],
    className
)}>
  <slot />
</section> 