---
import { Image } from "astro:assets";
// import ReservationForm from "templates/forms/ReservationForm.astro";
import { trans } from "~/utils/translations";

interface Props {
	lang: string;
}
const { lang } = Astro.props;
const logger = createLogger(false, "components.templates.home.hero");

import { backgroundImagesHero } from "../../../lib/constants";
// Importar la imagen directamente
import { createLogger, resolveImage } from "../../../utils";

// Seleccionar una imagen aleatoria
const imagesArray = Object.values(backgroundImagesHero);
logger.info("imagesArray", imagesArray);
const randomIndex = Math.floor(Math.random() * imagesArray.length);
logger.info("randomIndex", randomIndex);
const heroImage = imagesArray[randomIndex];
logger.info("heroImage", heroImage);
---

<div
    class="relative flex flex-col columns-1 items-center justify-start h-[55vh] sm:h-[60vh] md:h-[80vh] lg:h-[90vh] xl:h-[100vh] w-full">
  <div class="absolute inset-0">
    <Image
      alt="Hero Image"
      src={heroImage()}
      data-ai-hint="tropical resort pool"
      width={1280}
      height={720}
      loading="eager"
      class="object-cover w-full h-full"
      format="webp"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/40 to-transparent"></div>
  </div>

  <div class="absolute inset-0 flex flex-col items-center justify-center">
    <div class="px-4 md:px-6 max-w-4xl mx-auto">
      <h1
        class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl drop-shadow-md text-white"
      >
        {trans(lang, "home.hero.title")}
      </h1>
      <p
        class="mt-4 max-w-2xl mx-auto text-lg md:text-xl text-neutral-200 drop-shadow-xs text-center"
      >
        {trans(lang, "home.hero.subtitle")}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/hotels" class="btn btn-primary">
          {trans(lang, "home.hero.btn.view-hotels")}
        </a>
        <a href="/offers" class="btn btn-outline btn-secondary shadow-none hover:bg-white/10">
          {trans(lang, "home.hero.btn.view-offers")}
        </a>
      </div>
    </div>
  </div>

  {/* Booking Form Section */}
  <!-- <div class="relative z-10 w-full mt-12 md:mt-16 lg:mt-20 pb-12 px-4">
    <div class="container max-w-4xl mx-auto">
      <ReservationForm lang={lang} />
    </div>
  </div> -->
</div>
